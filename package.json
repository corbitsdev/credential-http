{
  "name": "@corbits/credential-http",
  "version": "0.1.0",
  "description": "Origin-pinned HTTP credential providers for Interchange: any header, x-api-key, raw Authorization, and MCP streamable HTTP.",
  "keywords": [
    "corbits",
    "credentials",
    "http",
    "interchange",
    "mcp"
  ],
  "homepage": "https://github.com/corbitsdev/credential-http#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/credential-http/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/credential-http.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test src --pass-with-no-tests",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "devDependencies": {
    "@intx/harness": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@intx/harness": "^0.4.0",
    "@intx/types": "^0.4.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  }
}
